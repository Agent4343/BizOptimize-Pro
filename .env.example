# BizOptimize Pro - Environment Variables
# Copy this file to .env.local for local development
# Add these variables to Railway dashboard for production

# ======================
# AI Provider (choose one or both)
# ======================

# OpenAI API Key (optional - for GPT models)
OPENAI_API_KEY=

# OpenRouter API Key (optional - for multiple AI models)
OPENROUTER_API_KEY=

# ======================
# Application Settings
# ======================

# Public app URL (used for OpenRouter referer header)
NEXT_PUBLIC_APP_URL=https://your-app.railway.app

# Node environment (set automatically by Railway)
NODE_ENV=production

# Port (set automatically by Railway)
PORT=3000
